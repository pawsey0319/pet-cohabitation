  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <application>
    <service android:name=".PetDesktopService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="specialUse">
