{
  "name": "pet-companion-desktop", "version": "1.1.1", "private": true,
  "description": "异宠 Windows 桌面陪伴", "author": "Pet Companion",
  "main": "main.cjs",
  "scripts": { "start": "electron .", "configure": "node scripts/configure.mjs", "test": "node --test tests/*.test.cjs", "check": "node --check main.cjs && node --check companion.cjs && node --check renderer.js && node --check preload.cjs", "dist:win": "node scripts/verify-config.cjs && electron-builder --win nsis --x64", "pack:win": "node scripts/verify-config.cjs && electron-builder --win dir --x64" },
  "dependencies": { "@supabase/supabase-js": "2.112.3" },
  "devDependencies": { "electron": "44.4.3", "electron-builder": "26.15.3" },
  "build": {
    "appId": "com.pawsey.petcohabitation.desktop", "productName": "异宠桌面伙伴",
    "asar": true, "icon": "assets/tray.png", "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs", "companion.cjs", "contracts.cjs", "renderer.js", "index.html", "styles.css", "config.production.json", "assets/**", "package.json"],
    "win": { "target": "nsis", "artifactName": "pet-desktop-${version}-${arch}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
