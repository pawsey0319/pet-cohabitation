{
  "expo": {
    "name": "异宠共生空间",
    "slug": "pet-cohabitation",
    "version": "1.0.3",
    "description": "轻量真实聊天与可培养生成式异宠 Demo。",
    "scheme": "pet-cohabitation",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#16142D",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "com.pawsey.petcohabitation",
      "versionCode": 4,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "异宠共生空间",
      "shortName": "异宠共生",
      "lang": "zh-CN",
      "themeColor": "#16142D",
      "description": "轻量真实聊天与可培养生成式异宠 Demo。",
      "display": "standalone",
      "orientation": "portrait"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#FF806F",
          "defaultChannel": "messages"
        }
      ],
      "expo-updates",
      "expo-sharing"
    ],
    "extra": {
      "publicAppUrl": "https://pet-cohabitation-public.vercel.app",
      "router": {},
      "eas": {
        "projectId": "8cc62f33-fbad-4b84-b0c7-2f579cbc9e37"
      }
    },
    "owner": "pawsey"
  }
}
